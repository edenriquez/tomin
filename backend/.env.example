# Tomin backend configuration.

# SQLAlchemy database URL. Defaults to a local SQLite file for offline dev.
# For Supabase Postgres use e.g.:
#   postgresql+psycopg2://postgres:<pwd>@db.<ref>.supabase.co:5432/postgres
# DATABASE_URL=sqlite:///tomin.db

# Supabase JWT secret used to verify bearer tokens from the mobile/web clients.
# Found in Supabase project settings -> API -> JWT Secret.
# SUPABASE_JWT_SECRET=your-jwt-secret

# When true, auth is bypassed and requests run as DEV_USER_ID (local dev only).
AUTH_DISABLED=true
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Where the DuckDB analytics cube file lives.
# CUBE_PATH=tomin_cube.duckdb

# CORS origins (comma separated). Use explicit origins in production.
CORS_ORIGINS=*

# Where the web dashboard lives. Used to build the "Ver en tu dashboard" link
# the device ingest endpoint returns to the phone.
FRONTEND_URL=http://localhost:3000

# The X25519 keypair phones seal their extracted text to. Minted on first
# bootstrap; gitignored, and a secret — losing it only costs the phones a
# re-pin, leaking it undoes the sealed envelope.
# INGEST_KEY_PATH=ingest_key.json
